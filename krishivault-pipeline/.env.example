# KrishiVault settings. Copy to .env for local work; in a cloud session set these in the cloud environment instead.
# Never put real values in this file.

# === Database ===
# Default: SQLite file in data/ (no setup needed)
# DATABASE_URL=sqlite:///./data/krishivault.db

# === AI: Google Gemini (understanding the farmer, wording the answer) ===
GEMINI_API_KEY=
# Optional: the Gemini model, or several separated by commas, tried in order
GEMINI_MODEL=

# === Bangla voice: Google Cloud Text-to-Speech (service-account key file) ===
# Local: path to the JSON key file. Cloud: the SessionStart hook writes the file from GOOGLE_TTS_JSON_B64.
GOOGLE_APPLICATION_CREDENTIALS=
# Cloud only: the JSON key file, base64-encoded on one line
GOOGLE_TTS_JSON_B64=
# Optional: bn-BD or bn-IN. Unset: bn-BD is tried first, then bn-IN
TTS_LANGUAGE=

# === SMS: REVE gateway (from Awaj Digital support). Dry run unless SMS_LIVE=1 ===
SMS_BASE_URL=https://smpp.revesms.com:7790
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_SENDER_ID=
SMS_LIVE=0

# === Voice calls: Awaj Digital broadcast. Not part of the prototype (no phone line); kept for later ===
AWAJ_API_TOKEN=
AWAJ_SENDER=
AWAJ_LIVE=0

# === Weather fallback (optional) ===
OPENWEATHER_API_KEY=

# === Call preview: optional secret for signing the SMS text kept in the browser (random per start if unset) ===
KV_STATE_SECRET=
